# Copy this file to .env.local and fill in the values. Never commit real secrets.

# Public URL of the deployed site, used for canonical links, sitemap and social cards.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Public contact details shown on the site. Leave empty to hide them.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_LOCATION=

# Social profiles. Leave empty to hide a link.
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_GITHUB=
NEXT_PUBLIC_SOCIAL_X=

# Contact form delivery (server only). Uses the Resend HTTP API: https://resend.com
# Without RESEND_API_KEY the form logs submissions in development and returns
# "not configured" in production, so nothing is silently lost.
RESEND_API_KEY=
# Inbox that receives enquiries.
CONTACT_TO_EMAIL=
# Verified sender, e.g. "Tredrox Website <website@your-domain.com>".
CONTACT_FROM_EMAIL=
